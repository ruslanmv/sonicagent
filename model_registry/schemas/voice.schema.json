{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "voices"
  ],
  "properties": {
    "schema_version": {
      "type": "integer"
    },
    "voices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "language",
          "locale",
          "model_path",
          "config_path",
          "license"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "locale": {
            "type": "string"
          },
          "model_path": {
            "type": "string"
          },
          "config_path": {
            "type": "string"
          },
          "license": {
            "type": "string"
          }
        }
      }
    }
  }
}
