FROM python:3.11-slim
RUN useradd --create-home --uid 10001 sonic
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir .
USER sonic
EXPOSE 8000
HEALTHCHECK CMD python deploy/docker/healthcheck.py || exit 1
CMD ["uvicorn", "sonicagent_rt.app:app", "--host", "0.0.0.0", "--port", "8000"]
