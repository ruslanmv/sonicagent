# Application
SONIC_HOST=0.0.0.0
SONIC_PORT=8000
SONIC_ENVIRONMENT=development
SONIC_LOG_LEVEL=INFO

# Sessions
SONIC_SESSION_TTL_SEC=1800
SONIC_MAX_SESSION_SEC=3600
SONIC_MAX_CONCURRENT_SESSIONS=8
SONIC_RESUME_WINDOW_SEC=30

# Authentication
SONIC_AUTH_MODE=development
SONIC_JWT_SECRET=replace-before-deployment
SONIC_ALLOWED_ORIGINS=http://localhost:5173

# Audio
SONIC_INPUT_SAMPLE_RATE=16000
SONIC_INPUT_CHANNELS=1
SONIC_AUDIO_FRAME_MS=20
SONIC_MAX_JITTER_MS=200
SONIC_MAX_OUTBOUND_QUEUE_MS=2000

# VAD
SONIC_VAD_PROVIDER=silero
SONIC_VAD_THRESHOLD=0.50
SONIC_VAD_MIN_SPEECH_MS=200
SONIC_VAD_MIN_SILENCE_MS=500
SONIC_VAD_PRE_ROLL_MS=200
SONIC_VAD_MAX_UTTERANCE_SEC=30

# STT
SONIC_STT_PROVIDER=faster-whisper
SONIC_STT_MODEL=small
SONIC_STT_DEVICE=cpu
SONIC_STT_COMPUTE_TYPE=int8
SONIC_STT_LANGUAGE=auto
SONIC_STT_PARTIALS_ENABLED=false

# LLM
SONIC_LLM_PROVIDER=mock
SONIC_LLM_BASE_URL=http://localhost:11434/v1
SONIC_LLM_API_KEY=
SONIC_LLM_MODEL=llama3.1:8b
SONIC_LLM_TEMPERATURE=0.4
SONIC_LLM_MAX_TOKENS=256

# TTS
SONIC_TTS_PROVIDER=piper
SONIC_TTS_VOICE=en_US-lessac-medium
SONIC_TTS_WORKERS=2
SONIC_TTS_PHRASE_MIN_CHARS=24
SONIC_TTS_PHRASE_MAX_CHARS=180
SONIC_TTS_CACHE_ENABLED=true

# Models
SONIC_HF_BASE=https://huggingface.co/ruslanmv/hp-piper-voices/resolve/main
SONIC_MODEL_CACHE_DIR=~/.cache/SonicAgent

# Barge-in
SONIC_BARGE_IN_ENABLED=true
SONIC_BARGE_IN_MIN_SPEECH_MS=80
SONIC_BARGE_IN_CANCEL_TIMEOUT_MS=200

# Observability
SONIC_METRICS_ENABLED=true
SONIC_OTEL_ENABLED=false
SONIC_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Privacy
SONIC_STORE_TRANSCRIPTS=false
SONIC_STORE_AUDIO=false
SONIC_LOG_TRANSCRIPT_CONTENT=false
