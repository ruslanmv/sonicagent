# Copy to hf/.env before local Docker Compose. Do not commit hf/.env.
# Generate a private value. Development mode accepts 16+ characters.
# Hugging Face production mode requires 24+ characters and rejects placeholders.

SONIC_API_KEY=
SONIC_ENVIRONMENT=development
SONIC_AUTH_MODE=development
SONIC_ALLOWED_ORIGINS=http://localhost:5173
SONIC_PUBLISH_PORT=8000

SONIC_STT_PROVIDER=faster-whisper
SONIC_STT_MODEL=tiny
SONIC_STT_DEVICE=cpu
SONIC_STT_COMPUTE_TYPE=int8
SONIC_STT_LANGUAGE=auto
SONIC_STT_WARMUP=true
SONIC_STT_ALLOW_DOWNLOAD=false
SONIC_MAX_AUDIO_SECONDS=15
SONIC_MAX_UPLOAD_BYTES=2097152
SONIC_STT_MAX_CONCURRENCY=2

SONIC_TTS_ENABLED=false
SONIC_STORE_AUDIO=false
SONIC_STORE_TRANSCRIPTS=false
SONIC_LOG_TRANSCRIPT_CONTENT=false
